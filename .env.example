# Copy to .env — never commit .env

# Wallet that pays gas on the L2 testnet you deploy to
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_WITHOUT_QUOTES

# --- Arbitrum Sepolia (recommended if your MetaMask balance is here) ---
ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# https://etherscan.io/myapikey — used for Arbiscan verification on Arbitrum Sepolia
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY

# Optional: Chainlink ETH/USD on Arbitrum Sepolia (see chain.link docs for current address)
# CHAINLINK_ETH_USD_FEED=0x...

# --- Base Sepolia (alternative L2) ---
# BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# BASESCAN_API_KEY=YOUR_BASESCAN_API_KEY
